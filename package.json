{
  "name": "mimirtalk-android",
  "version": "1.1.1",
  "private": true,
  "description": "MimirTalk 安卓套壳工程：用 Capacitor 把 webui 静态包打包为安卓应用。",
  "scripts": {
    "build:web": "powershell -NoProfile -ExecutionPolicy Bypass -File android/tools/build_web_assets.ps1",
    "sync:android": "cap copy android",
    "build:debug": "powershell -NoProfile -ExecutionPolicy Bypass -File android/tools/build_debug.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
